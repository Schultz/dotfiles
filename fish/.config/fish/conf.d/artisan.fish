if status is-interactive
    abbr --add art 'php artisan'
    abbr --add arts 'php artisan serve'
    abbr --add artm 'php artisan migrate'
    abbr --add artms 'php artisan migrate --seed'
    abbr --add artmr 'php artisan migrate:rollback'
    abbr --add artmc 'php artisan migrate:status'
    abbr --add artc 'php artisan cache:clear'
    abbr --add artcc 'php artisan config:cache'
    abbr --add artcs 'php artisan config:clear'
    abbr --add artv 'php artisan view:clear'
    abbr --add artk 'php artisan key:generate'
    abbr --add artl 'php artisan list'
end